# GitHub Personal Access Token — SERVER-ONLY (read by api/github/* on Vercel).
# Do NOT prefix with VITE_; that would inline it into the public browser bundle.
# Fine-grained token: Repository access "Public repositories", plus account
# permission "Read" is enough for stars/languages/contribution counts.
# Set on Vercel:  vercel env add GITHUB_TOKEN   (production, preview, development)
# Pull locally:   vercel env pull .env.local    (used by `npm run dev:vercel`)
GITHUB_TOKEN=your_token_here

# Optional: Supabase keep-alive (prevents free-tier project from pausing)
# Get from Supabase Dashboard → Project Settings → API. In SQL Editor run:
#   create table public._keepalive (id int primary key);
#   insert into public._keepalive values (1) on conflict (id) do nothing;
# If RLS is on, add policy: allow anon select on _keepalive.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
